const LiveTracking = () => {
  const { t } = useLanguage();
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedEmployee, setSelectedEmployee] = useState('all');
  const [selectedDepartment, setSelectedDepartment] = useState('all');
  const [selectedStatus, setSelectedStatus] = useState('all');
  const [dateRange, setDateRange] = useState('today');
  const [currentPage, setCurrentPage] = useState(1);
  const itemsPerPage = 6;
  
  // API related states
  const [liveTrackingData, setLiveTrackingData] = useState([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');
  const [totalCount, setTotalCount] = useState(0);
  const [activityStats, setActivityStats] = useState({
    totalActive: 0,
    online: 0,
    idle: 0,
    offline: 0,
    totalHours: '0h'
  });

  // Fetch live tracking data from API
  const fetchLiveTrackingData = async () => {
    try {
      setLoading(true);
      setError('');
      
      const params = new URLSearchParams();
      
      // Use the live tracking endpoint with appropriate limit
      const limit = itemsPerPage * currentPage; // Get enough items for current page
      params.append('limit', limit.toString());
      
      // Add search filter if provided
      if (searchQuery.trim()) {
        params.append('search', searchQuery.trim());
      }
      
      // Add date filter if needed
      if (dateRange && dateRange !== 'today') {
        params.append('date_range', dateRange);
      }
      
      const apiUrl = `http://127.0.0.1:8000/api/live-tracking/fast-screenshots/?${params.toString()}`;
      console.log('Fetching live tracking screenshots from:', apiUrl);
      
      const response = await axios.get(apiUrl, {
        timeout: 10000,
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        // Add CORS configuration if needed
        withCredentials: false
      });
      
      console.log('Live tracking API response:', response.data);
      
      let screenshots = [];
      let total = 0;
      
      // Handle response from live tracking endpoint
      if (Array.isArray(response.data)) {
        // Direct array response
        screenshots = response.data;
        total = screenshots.length;
      } else if (response.data && response.data.screenshots && Array.isArray(response.data.screenshots)) {
        // Wrapped response
        screenshots = response.data.screenshots;
        total = response.data.total_count || response.data.count || screenshots.length;
      } else if (response.data && response.data.results && Array.isArray(response.data.results)) {
        // Results wrapped response
        screenshots = response.data.results;
        total = response.data.count || response.data.total_count || screenshots.length;
      } else if (response.data && response.data.data && Array.isArray(response.data.data)) {
        // Data wrapped response
        screenshots = response.data.data;
        total = screenshots.length;
      } else {
        console.warn('Unexpected live tracking API response structure:', response.data);
        screenshots = [];
        total = 0;
      }
      
      // Apply client-side search filtering if needed
      if (searchQuery.trim() && screenshots.length > 0) {
        const searchLower = searchQuery.toLowerCase();
        screenshots = screenshots.filter(screenshot => {
          return (screenshot.user_name && screenshot.user_name.toLowerCase().includes(searchLower)) ||
                 (screenshot.username && screenshot.username.toLowerCase().includes(searchLower)) ||
                 (screenshot.employee_name && screenshot.employee_name.toLowerCase().includes(searchLower)) ||
                 (screenshot.application && screenshot.application.toLowerCase().includes(searchLower)) ||
                 (screenshot.window_title && screenshot.window_title.toLowerCase().includes(searchLower));
        });
        total = screenshots.length;
      }
      
      // Apply pagination (client-side for now)
      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;
      const paginatedScreenshots = screenshots.slice(startIndex, endIndex);
      
      setLiveTrackingData(paginatedScreenshots);
      setTotalCount(total);
      
      // Calculate activity stats from screenshot data
      const userStats = {};
      screenshots.forEach(screenshot => {
        const user = screenshot.user_name || screenshot.username || screenshot.employee_name || 'Unknown';
        if (!userStats[user]) {
          userStats[user] = { online: 0, idle: 0, offline: 0 };
        }
        
        const status = (screenshot.status || screenshot.activity_status || 'active').toLowerCase();
        if (status.includes('online') || status.includes('active')) {
          userStats[user].online++;
        } else if (status.includes('idle')) {
          userStats[user].idle++;
        } else {
          userStats[user].offline++;
        }
      });
      
      const totalUsers = Object.keys(userStats).length;
      const onlineUsers = Object.values(userStats).filter(stat => stat.online > 0).length;
      const idleUsers = Object.values(userStats).filter(stat => stat.idle > 0 && stat.online === 0).length;
      const offlineUsers = totalUsers - onlineUsers - idleUsers;
      
      setActivityStats({
        totalActive: totalUsers,
        online: onlineUsers,
        idle: idleUsers,
        offline: offlineUsers,
        totalHours: `${Math.floor(screenshots.length / 10)}h` // Rough estimate based on screenshot count
      });
      
    } catch (err) {
      console.error('Error fetching live tracking data:', err);
      
      if (err.response) {
        setError(`Server error: ${err.response.status} - ${err.response.data.message || err.response.data.detail || 'Failed to fetch live tracking data'}`);
      } else if (err.request) {
        setError('Network error: Unable to connect to server. Please ensure your backend server is running on http://127.0.0.1:8000');
      } else {
        setError('An unexpected error occurred while fetching live tracking data');
      }
    } finally {
      setLoading(false);
    }
  };

  // Load live tracking data on component mount
  useEffect(() => {
    const loadInitialData = async () => {
      console.log('🔄 Loading initial live tracking data...');
      try {
        await fetchLiveTrackingData();
      } catch (err) {
        console.error('❌ Error loading initial live tracking data:', err);
      }
    };

    // Load data immediately on mount
    loadInitialData();
  }, []);

  // Fetch data when component mounts or filters change
  useEffect(() => {
    const timer = setTimeout(() => {
      fetchLiveTrackingData();
    }, 300); // 300ms debounce for search

    return () => clearTimeout(timer);
  }, [searchQuery, selectedEmployee, dateRange, currentPage]);

  // Format tracking data for display
  const formatTrackingData = (screenshot, index) => {
    // Extract time from timestamp or filename
    let displayTime = 'Unknown Time';
    if (screenshot.timestamp) {
      displayTime = new Date(screenshot.timestamp).toLocaleTimeString();
    } else if (screenshot.created_at) {
      displayTime = new Date(screenshot.created_at).toLocaleTimeString();
    } else if (screenshot.captured_at) {
      displayTime = new Date(screenshot.captured_at).toLocaleTimeString();
    } else if (screenshot.filename) {
      // Extract time from filename format like "2025-06-28_17-42-24_2025-06-28_17-42-23.webp"
      const timeFromFilename = screenshot.filename.split('_')[1]?.replace(/-/g, ':');
      if (timeFromFilename) {
        displayTime = timeFromFilename;
      }
    }
    
    // Extract date
    let displayDate = 'Unknown Date';
    if (screenshot.timestamp) {
      displayDate = new Date(screenshot.timestamp).toLocaleDateString();
    } else if (screenshot.created_at) {
      displayDate = new Date(screenshot.created_at).toLocaleDateString();
    } else if (screenshot.captured_at) {
      displayDate = new Date(screenshot.captured_at).toLocaleDateString();
    } else if (screenshot.filename) {
      const dateFromFilename = screenshot.filename.split('_')[0];
      if (dateFromFilename) {
        displayDate = dateFromFilename;
      }
    }
    
    return {
      id: screenshot.id || screenshot.key || screenshot.file_path || index,
      task: screenshot.window_title || screenshot.application || screenshot.app_name || screenshot.task_name || `Activity ${index + 1}`,
      time: displayTime,
      screenshot: screenshot.screenshot_url || screenshot.url || screenshot.thumbnail_url || screenshot.image_url || screenshot.file_path || null,
      status: (screenshot.status || screenshot.activity_status || 'active').toLowerCase(),
      employee: screenshot.user_name || screenshot.username || screenshot.employee_name || 'Unknown User',
      email: screenshot.email || screenshot.user_email || '',
      department: screenshot.department || 'Unknown Department',
      duration: screenshot.duration || screenshot.session_duration || 'N/A',
      productivity: screenshot.productivity_score || screenshot.efficiency || 'N/A',
      taskPriority: screenshot.priority || 'Normal',
      location: screenshot.location || 'Unknown Location',
      lastActivity: screenshot.last_activity || displayTime,
      screenshotsCount: 1, // Each item is a screenshot
      isActive: (screenshot.status || '').toLowerCase().includes('active') || 
                (screenshot.status || '').toLowerCase().includes('online'),
      profileImage: screenshot.profile_image || screenshot.user_avatar,
      application: screenshot.application || screenshot.app_name || 'Unknown App',
      window_title: screenshot.window_title || 'Unknown Window',
      file_size: screenshot.file_size || screenshot.size,
      date: displayDate
    };
  };

  const employees = [
    { id: 'all', name: t('allEmployees') },
    { id: 'beyza', name: 'BEYZA DÖNMEZ' },
    { id: 'john', name: 'JOHN SMITH' },
    { id: 'sarah', name: 'SARAH JOHNSON' },
    { id: 'amir', name: 'AMIR' }
  ];

  const departments = [
    { id: 'all', name: t('allDepartments') },
    { id: 'dev', name: t('development') },
    { id: 'design', name: t('design') },
    { id: 'marketing', name: t('marketing') }
  ];

  const allScreenshots = Array.from({ length: 24 }, (_, i) => ({
    id: i + 1,
    task: `${t('development')} ${t('task')} ${i + 1}`,
    time: `${9 + (i % 8)}:${String(Math.floor(Math.random() * 60)).padStart(2, '0')} ${i % 2 === 0 ? 'AM' : 'PM'}`,
    screenshot: `Screenshot ${i + 1}`,
    status: i % 3 === 0 ? 'online' : i % 3 === 1 ? 'idle' : 'offline',
    employee: employees[Math.floor(Math.random() * (employees.length - 1)) + 1].name,
    department: departments[Math.floor(Math.random() * (departments.length - 1)) + 1].name
  }));

  // Filter screenshots based on current filters - now using live tracking API data
  const filteredScreenshots = liveTrackingData.length > 0 
    ? liveTrackingData.map((screenshot, index) => formatTrackingData(screenshot, index))
    : [];

  const totalPages = Math.ceil(totalCount / itemsPerPage);
  const displayedItems = filteredScreenshots;

  const handlePageChange = (page) => {
    setCurrentPage(page);
  };

  // Reset to first page when filters change
  useEffect(() => {
    setCurrentPage(1);
  }, [searchQuery, selectedEmployee, dateRange]);

  const generatePageNumbers = () => {
    const pages = [];
    const maxVisiblePages = 5;
    
    if (totalPages <= maxVisiblePages) {
      for (let i = 1; i <= totalPages; i++) {
        pages.push(i);
      }
    } else {
      if (currentPage <= 3) {
        for (let i = 1; i <= 4; i++) pages.push(i);
        pages.push('...');
        pages.push(totalPages);
      } else if (currentPage >= totalPages - 2) {
        pages.push(1);
        pages.push('...');
        for (let i = totalPages - 3; i <= totalPages; i++) pages.push(i);
      } else {
        pages.push(1);
        pages.push('...');
        for (let i = currentPage - 1; i <= currentPage + 1; i++) pages.push(i);
        pages.push('...');
        pages.push(totalPages);
      }
    }
    
    return pages;
  };

  return (
    <DashboardLayout headerTitle={t('liveTracking')} headerBreadcrumb={`${t('home')} / ${t('liveTracking')}`}>
      <LiveTrackingContainer>
        <Container>
          <ContentSection>
            <TrackingCard>
              <CardHeader>
                <Title>
                  � Live Screenshot Tracking
                  <span style={{ fontSize: '14px', opacity: 0.7 }}>ⓘ</span>
                </Title>
              </CardHeader>

              <ActivityInfo>
                <InfoItem>
                  <div className="icon">👥</div>
                  <div className="label">{t('totalActive')}</div>
                  <div className="value">{activityStats.totalActive}</div>
                </InfoItem>
                <InfoItem>
                  <div className="icon">🟢</div>
                  <div className="label">{t('online')}</div>
                  <div className="value">{activityStats.online}</div>
                </InfoItem>
                <InfoItem>
                  <div className="icon">🟡</div>
                  <div className="label">{t('idle')}</div>
                  <div className="value">{activityStats.idle}</div>
                </InfoItem>
                <InfoItem>
                  <div className="icon">🔴</div>
                  <div className="label">{t('offline')}</div>
                  <div className="value">{activityStats.offline}</div>
                </InfoItem>
                <InfoItem>
                  <div className="icon">⏰</div>
                  <div className="label">{t('totalHours')}</div>
                  <div className="value">{activityStats.totalHours}</div>
                </InfoItem>
              </ActivityInfo>

              <FilterSection>
                <LeftFilters>
                  <FilterDropdown 
                    value={selectedEmployee} 
                    onChange={(e) => setSelectedEmployee(e.target.value)}
                  >
                    {employees.map(emp => (
                      <option key={emp.id} value={emp.id}>{emp.name}</option>
                    ))}
                  </FilterDropdown>

                  <FilterDropdown 
                    value={dateRange} 
                    onChange={(e) => setDateRange(e.target.value)}
                  >
                    <option value="today">{t('today')}</option>
                    <option value="week">{t('thisWeek')}</option>
                    <option value="month">{t('thisMonth')}</option>
                    <option value="year">This Year</option>
                  </FilterDropdown>
                </LeftFilters>

                <RightFilters>
                  <SearchInput
                    placeholder="Search by user name, application, or window title..."
                    value={searchQuery}
                    onChange={(e) => setSearchQuery(e.target.value)}
                  />
                </RightFilters>
              </FilterSection>

              {loading && (
                <LoadingContainer>
                  <CircularProgress />
                  <div>Loading live tracking screenshots...</div>
                </LoadingContainer>
              )}

              {error && (
                <ErrorMessage>
                  {error}
                  <button 
                    onClick={fetchLiveTrackingData} 
                    style={{ marginLeft: '10px', fontSize: '12px', padding: '4px 8px', cursor: 'pointer' }}
                  >
                    Retry
                  </button>
                </ErrorMessage>
              )}

              {!loading && !error && displayedItems.length === 0 && (
                <NoDataMessage>
                  No live tracking data found
                  <br />
                  <small>Try adjusting your search query or check if the live tracking server is running on http://127.0.0.1:8000</small>
                </NoDataMessage>
              )}

              <ResultsInfo>
                <span>
                  {t('showing')} {displayedItems.length > 0 ? ((currentPage - 1) * itemsPerPage + 1) : 0}-{Math.min(currentPage * itemsPerPage, totalCount)} {t('of')} {totalCount} {t('results')}
                </span>
                <span>{displayedItems.length} {t('itemsOnThisPage')}</span>
              </ResultsInfo>

              <ScreenshotGrid>
                {displayedItems.map((item) => (
                  <ScreenshotCard key={item.id}>
                    <ScreenshotImage>
                      {item.screenshot && item.screenshot !== `Screenshot ${item.id}` ? (
                        <img 
                          src={item.screenshot} 
                          alt={item.task}
                          style={{ width: '100%', height: '100%', objectFit: 'cover', borderRadius: '8px' }}
                          onError={(e) => {
                            e.target.style.display = 'none';
                            e.target.parentElement.innerHTML = `
                              <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%;">
                                <div style="font-size: 32px; margin-bottom: 8px;">📸</div>
                                <div style="font-size: 12px; opacity: 0.7;">Screenshot Preview</div>
                              </div>
                            `;
                          }}
                        />
                      ) : null}
                    </ScreenshotImage>
                    <CardContent>
                      <TaskHeader>
                        <TaskName>{item.task}</TaskName>
                        <StatusBadge status={item.status}>
                          {item.status.charAt(0).toUpperCase() + item.status.slice(1)}
                        </StatusBadge>
                      </TaskHeader>
                      <div style={{ fontSize: '12px', color: '#6b7280', marginBottom: '4px', display: 'flex', alignItems: 'center', gap: '4px' }}>
                        {item.profileImage ? (
                          <img 
                            src={item.profileImage} 
                            alt={item.employee}
                            style={{ width: '16px', height: '16px', borderRadius: '50%' }}
                          />
                        ) : (
                          <span>👤</span>
                        )}
                        {item.employee}
                        {item.isActive && <span style={{ color: '#10b981', fontSize: '10px' }}>●</span>}
                      </div>
                      {item.email && (
                        <div style={{ fontSize: '10px', color: '#9ca3af', marginBottom: '4px' }}>
                          📧 {item.email}
                        </div>
                      )}
                      {item.duration && item.duration !== 'N/A' && (
                        <div style={{ fontSize: '11px', color: '#6366f1', marginBottom: '4px' }}>
                          ⏱️ Working Time: {item.duration}
                        </div>
                      )}
                      {item.productivity && item.productivity !== 'N/A' && (
                        <div style={{ fontSize: '11px', color: '#059669', marginBottom: '4px' }}>
                          📊 Efficiency: {item.productivity}
                        </div>
                      )}
                      {item.window_title && item.window_title !== 'Unknown Window' && (
                        <div style={{ fontSize: '10px', color: '#6366f1', marginBottom: '4px' }}>
                          🪟 {item.window_title}
                        </div>
                      )}
                      {item.application && item.application !== 'Unknown App' && (
                        <div style={{ fontSize: '10px', color: '#8b5cf6', marginBottom: '4px' }}>
                          � {item.application}
                        </div>
                      )}
                      {item.file_size && (
                        <div style={{ fontSize: '10px', color: '#f59e0b', marginBottom: '4px' }}>
                          💾 {typeof item.file_size === 'number' ? `${Math.round(item.file_size / 1024)} KB` : item.file_size}
                        </div>
                      )}
                      {item.date && item.date !== 'Unknown Date' && (
                        <div style={{ fontSize: '10px', color: '#6b7280', marginBottom: '4px' }}>
                          📅 {item.date}
                        </div>
                      )}
                      {item.taskPriority && (
                        <div style={{ 
                          fontSize: '10px', 
                          marginBottom: '4px',
                          padding: '2px 6px',
                          borderRadius: '8px',
                          backgroundColor: item.taskPriority.toLowerCase() === 'high' ? '#fef2f2' : 
                                         item.taskPriority.toLowerCase() === 'medium' ? '#fef3c7' : '#f0f9ff',
                          color: item.taskPriority.toLowerCase() === 'high' ? '#dc2626' : 
                                item.taskPriority.toLowerCase() === 'medium' ? '#d97706' : '#0369a1',
                          fontWeight: '500'
                        }}>
                          🎯 {item.taskPriority} Priority
                        </div>
                      )}
                      {item.location && item.location !== 'Unknown Location' && (
                        <div style={{ fontSize: '10px', color: '#6b7280', marginBottom: '4px' }}>
                          📍 {item.location}
                        </div>
                      )}
                      {item.lastActivity && item.lastActivity !== 'Unknown' && (
                        <div style={{ fontSize: '10px', color: '#f59e0b', marginBottom: '4px' }}>
                          🔄 Last active: {item.lastActivity}
                        </div>
                      )}
                      <TaskMeta>
                        <TaskTime>{item.time}</TaskTime>
                      </TaskMeta>
                    </CardContent>
                  </ScreenshotCard>
                ))}
              </ScreenshotGrid>

              {totalPages > 1 && (
                <PaginationContainer>
                  <PaginationButton
                    onClick={() => handlePageChange(currentPage - 1)}
                    disabled={currentPage === 1}
                  >
                    ← {t('previous')}
                  </PaginationButton>

                  {generatePageNumbers().map((page, index) => (
                    <PaginationButton
                      key={index}
                      active={page === currentPage}
                      onClick={() => typeof page === 'number' && handlePageChange(page)}
                      disabled={page === '...'}
                    >
                      {page}
                    </PaginationButton>
                  ))}

                  <PaginationButton
                    onClick={() => handlePageChange(currentPage + 1)}
                    disabled={currentPage === totalPages}
                  >
                    {t('next')} →
                  </PaginationButton>

                  <PaginationInfo>
                    {t('page')} {currentPage} {t('of')} {totalPages}
                  </PaginationInfo>
                </PaginationContainer>
              )}
            </TrackingCard>
          </ContentSection>
        </Container>
      </LiveTrackingContainer>
    </DashboardLayout>
  );
};

export default LiveTracking;
