      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_base}}/test/",
          "host": ["{{api_base}}"],
          "path": ["test", ""]
        },
        "description": "Test if API is working"
      }
    },
    {
      "name": "2. Login API",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin\"\n}"
        },
        "url": {
          "raw": "{{api_base}}/auth/login/",
          "host": ["{{api_base}}"],
          "path": ["auth", "login", ""]
        }
      }
