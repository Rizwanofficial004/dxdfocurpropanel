						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email_or_username\": \"testapi@example.com\",\n  \"password\": \"testpassword123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login",
								""
							]
						},
						"description": "🔧 **FIXED VERSION** - Will work after backend deployment\n\n**Enhanced Features:**\n- Supports both email and username login\n- Better validation and error messages\n- Comprehensive password strength checks\n\n**Request Format (Flexible):**\n```json\n{\n  \"email_or_username\": \"testapi@example.com\",\n  \"password\": \"testpassword123\"\n}\n```\n\n**Expected Response (200):**\n```json\n{\n  \"status\": \"success\",\n  \"message\": \"Login successful\",\n  \"token\": \"jwt_token_here\",\n  \"drf_token\": \"drf_token_here\",\n  \"user\": {...}\n}\n```"
					},
					"response": []
				},
