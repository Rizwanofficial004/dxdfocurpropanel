							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"postmantest@example.com\",\n  \"email\": \"postmantest@example.com\",\n  \"password\": \"PostmanTest123\",\n  \"password_confirm\": \"PostmanTest123\",\n  \"first_name\": \"Postman\",\n  \"last_name\": \"Test\",\n  \"organization_name\": \"Test Organization\",\n  \"country\": \"USA\"\n}"
						},
