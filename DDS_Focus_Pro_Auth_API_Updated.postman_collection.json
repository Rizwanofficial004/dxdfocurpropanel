							"raw": "{{base_url}}/auth/login/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login",
								""
							]
						},
						"description": "⚠️ **BACKEND BUG** - Returns HTTP 500\n\n**Current Issue:**\n- Backend expects `email_or_username` field\n- API validation requires `email` field\n- Results in: `{\"status\":\"error\",\"message\":\"Login failed: 'email_or_username'\"}`\n\n**Request Format:**\n```json\n{\n  \"email\": \"testapi@example.com\",\n  \"password\": \"testpassword123\"\n}\n```\n\n**Current Response (500):**\n```json\n{\n  \"status\": \"error\",\n  \"message\": \"Login failed: 'email_or_username'\"\n}\n```"
					},
					"response": []
				},
				{
					"name": "🔧 Login (Fixed - For Future Use)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
