								"{{base_url}}"
							],
							"path": [
								"auth",
								"register",
								""
							]
						},
						"description": "✅ **WORKING** - Register new user account\n\n**Required Fields:**\n- username (same as email)\n- email\n- password\n- password_confirm ⚠️ (Required but missing from docs)\n- first_name\n- last_name\n- organization_name\n- country\n\n**Expected Response (201):**\n```json\n{\n  \"status\": \"success\",\n  \"message\": \"User registered successfully with unique email\",\n  \"user\": {...},\n  \"token\": \"auth_token_here\"\n}\n```"
					},
					"response": []
				},
				{
					"name": "⚠️ Login (Current - Has Backend Bug)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
