	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-set timestamp for unique usernames",
					"pm.environment.set('timestamp', Date.now());"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-save authentication token from successful responses",
					"if (pm.response.code === 200 || pm.response.code === 201) {",
					"    var jsonData = pm.response.json();",
					"    if (jsonData.token) {",
					"        pm.environment.set('auth_token', jsonData.token);",
					"        console.log('Auth token saved:', jsonData.token);",
					"    }",
					"    if (jsonData.drf_token) {",
					"        pm.environment.set('drf_token', jsonData.drf_token);",
					"        console.log('DRF token saved:', jsonData.drf_token);",
					"    }",
					"}",
					"",
					"// Log response for debugging",
					"console.log('Response Status:', pm.response.code);",
					"console.log('Response Body:', pm.response.text());"
				]
			}
		}
	],
