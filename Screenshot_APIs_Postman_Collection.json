{
	"info": {
		"_postman_id": "screenshot-apis-collection",
		"name": "Screenshot Tracking APIs",
		"description": "Complete collection of Screenshot Tracking System APIs with auto-scheduler",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Health Check",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"API is working\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"API is working\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/test/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"test",
						""
					]
				},
				"description": "Basic health check to verify API is working"
			},
			"response": []
		},
		{
			"name": "2. Scheduler Status",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has scheduler info\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('scheduler');",
							"    pm.expect(jsonData.scheduler).to.have.property('is_running');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/scheduler/status/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"scheduler",
						"status",
						""
					]
				},
				"description": "Check auto-scheduler status (runs every 6 hours)"
			},
			"response": []
		},
		{
			"name": "3. All Users Screenshot Counts",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has users data\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('users');",
							"    pm.expect(jsonData).to.have.property('total_users');",
							"    pm.expect(jsonData).to.have.property('total_screenshots');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/users/screenshots-count/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"users",
						"screenshots-count",
						""
					]
				},
				"description": "Get screenshot counts for all users"
			},
			"response": []
		},
		{
			"name": "4. Top 5 Users by Screenshot Count",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has max 5 users\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.users.length).to.be.at.most(5);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/users/screenshots-count/?limit=5&sort_by=count&order=desc",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"users",
						"screenshots-count",
						""
					],
					"query": [
						{
							"key": "limit",
							"value": "5",
							"description": "Maximum number of users to return"
						},
						{
							"key": "sort_by",
							"value": "count",
							"description": "Sort by screenshot count"
						},
						{
							"key": "order",
							"value": "desc",
							"description": "Descending order (highest first)"
						}
					]
				},
				"description": "Get top 5 users with most screenshots"
			},
			"response": []
		},
		{
			"name": "5. Users with 1000+ Screenshots",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"All users have 1000+ screenshots\", function () {",
							"    var jsonData = pm.response.json();",
							"    jsonData.users.forEach(function(user) {",
							"        pm.expect(user.screenshot_count).to.be.at.least(1000);",
							"    });",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/users/screenshots-count/?min_count=1000&sort_by=count&order=desc",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"users",
						"screenshots-count",
						""
					],
					"query": [
						{
							"key": "min_count",
							"value": "1000",
							"description": "Minimum screenshot count"
						},
						{
							"key": "sort_by",
							"value": "count",
							"description": "Sort by screenshot count"
						},
						{
							"key": "order",
							"value": "desc",
							"description": "Descending order"
						}
					]
				},
				"description": "Get users with at least 1000 screenshots"
			},
			"response": []
		},
		{
			"name": "6. Users Sorted by Email",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/users/screenshots-count/?sort_by=email&order=asc&limit=10",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"users",
						"screenshots-count",
						""
					],
					"query": [
						{
							"key": "sort_by",
							"value": "email",
							"description": "Sort by email address"
						},
						{
							"key": "order",
							"value": "asc",
							"description": "Ascending order (A-Z)"
						},
						{
							"key": "limit",
							"value": "10",
							"description": "Limit to 10 users"
						}
					]
				},
				"description": "Get users sorted alphabetically by email"
			},
			"response": []
		},
		{
			"name": "7. Quick Summary Statistics",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has summary data\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('summary');",
							"    pm.expect(jsonData.summary).to.have.property('total_users');",
							"    pm.expect(jsonData.summary).to.have.property('total_screenshots');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/users/screenshots-summary/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"users",
						"screenshots-summary",
						""
					]
				},
				"description": "Get quick summary statistics with top users"
			},
			"response": []
		},
		{
			"name": "8. System Tracking Status",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/screenshots/tracking-status/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"screenshots",
						"tracking-status",
						""
					]
				},
				"description": "Get system tracking status and statistics"
			},
			"response": []
		},
		{
			"name": "9. Ultra-Fast Screenshots (Limited)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/screenshots/ultra-fast/?limit=3",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"screenshots",
						"ultra-fast",
						""
					],
					"query": [
						{
							"key": "limit",
							"value": "3",
							"description": "Limit to 3 users for testing"
						}
					]
				},
				"description": "Get ultra-fast cached screenshot data (limited for testing)"
			},
			"response": []
		},
		{
			"name": "10. Start Scheduler (POST)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Action was successful\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.be.true;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"action\": \"start\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/scheduler/status/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"scheduler",
						"status",
						""
					]
				},
				"description": "Start the auto-scheduler manually"
			},
			"response": []
		},
		{
			"name": "11. Stop Scheduler (POST)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"action\": \"stop\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/scheduler/status/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
