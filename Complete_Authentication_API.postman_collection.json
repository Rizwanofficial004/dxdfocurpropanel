				{
					"name": "1️⃣ Register New User (Get Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Auto-save tokens from successful registration",
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.environment.set('auth_token', jsonData.token);",
									"        pm.environment.set('user_email', jsonData.user.email);",
									"        pm.environment.set('user_password', 'TestPassword123'); // For login testing",
									"        console.log('✅ Registration successful!');",
									"        console.log('Token saved:', jsonData.token);",
									"        console.log('Email saved:', jsonData.user.email);",
									"    }",
									"} else {",
									"    console.log('❌ Registration failed');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"testuser_{{timestamp}}@example.com\",\n  \"email\": \"testuser_{{timestamp}}@example.com\",\n  \"password\": \"TestPassword123\",\n  \"password_confirm\": \"TestPassword123\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"User\",\n  \"organization_name\": \"Test Organization\",\n  \"country\": \"USA\"\n}"
						},
