              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"date\": \"invalid-date\",\n  \"limit\": 10,\n  \"page\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/screenshots/",
              "host": ["{{base_url}}"],
