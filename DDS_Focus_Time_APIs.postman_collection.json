      ]
    },
    {
      "name": "Legacy (Backward Compatibility)",
      "item": [
        {
          "name": "Legacy Update Logs",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"staffid\": 123,\n  \"email\": \"{{test_email}}\",\n  \"activity\": \"legacy_test\",\n  \"timestamp\": \"2025-01-15T10:30:00Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/update-log-info/",
              "host": ["{{base_url}}"],
              "path": ["update-log-info", ""]
            },
            "description": "Legacy endpoint for backward compatibility"
          },
          "response": []
        }
      ]
    }
  ]
}
