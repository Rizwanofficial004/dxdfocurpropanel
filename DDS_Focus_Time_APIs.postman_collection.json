            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{test_email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/logs/",
              "host": ["{{base_url}}"],
              "path": ["logs", ""]
            },
            "description": "Test validation for missing required fields"
          },
          "response": []
