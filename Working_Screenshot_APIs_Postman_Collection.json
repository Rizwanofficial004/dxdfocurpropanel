							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response is JSON\", function () {",
							"    pm.response.to.be.json;",
							"});",
							"",
							"pm.test(\"Response has required fields\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('success');",
							"    pm.expect(jsonData).to.have.property('total_users');",
							"    pm.expect(jsonData).to.have.property('total_screenshots');",
							"    pm.expect(jsonData).to.have.property('users');",
							"});",
							"",
							"pm.test(\"Users array contains data\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.users).to.be.an('array');",
							"    pm.expect(jsonData.users.length).to.be.greaterThan(0);",
							"});",
							"",
							"console.log(\"📊 Total Users:\", pm.response.json().total_users);",
							"console.log(\"📷 Total Screenshots:\", pm.response.json().total_screenshots.toLocaleString());"
